# ── 阿里云百炼（Embedding + Rerank） ──
RR_EMBEDDING_API_KEY=your_dashscope_api_key
RR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RR_EMBEDDING_MODEL=text-embedding-v4

RR_RERANK_API_KEY=your_dashscope_api_key
RR_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RR_RERANK_MODEL=qwen3-rerank

# ── LLM ──
RR_LLM_API_KEY=your_llm_api_key
RR_LLM_PROVIDER=openai
RR_LLM_BASE_URL=https://your_llm_base_url/v1
RR_LLM_MODEL=your_model_name

# ── 搜索（Tavily） ──
RR_SEARCH_API_KEY=your_tavily_api_key

# ── Tushare 研报索引 ──
RR_TUSHARE_TOKEN=your_tushare_token

# ── TextIn PDF 转换 ──
RR_TEXTIN_APP_ID=your_textin_app_id
RR_TEXTIN_SECRET_CODE=your_textin_secret_code

# ── 数据库 ──
RR_DATABASE_URL=postgresql://user:password@host:port/database

# ── 默认记忆库 ──
RR_DEFAULT_BANK=deep-research
